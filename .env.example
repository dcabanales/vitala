# Desarrollo local con datos ficticios. Nunca guardes secretos en Git.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://usuario@127.0.0.1:5432/vitala_dev
# Mantener estable y respaldado: también cifra el secreto de MFA.
SESSION_SECRET=al-menos-32-caracteres-aleatorios
OBJECT_STORAGE_DRIVER=local
LOCAL_OBJECT_DIR=/private/tmp/vitala-objects
OPENAI_MODEL=gpt-6-luna

# Producción: bucket privado de Neon Object Storage en la misma región/branch.
# OBJECT_BUCKET=vitala-documents
# AWS_ENDPOINT_URL_S3=https://...
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# OPENAI_API_KEY=... (secreto de Fly, no archivo versionado)
